#include "keyball39.dtsi"

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&pro_micro 4 GPIO_ACTIVE_HIGH>
        , <&pro_micro 5 GPIO_ACTIVE_HIGH>
        , <&pro_micro 6 GPIO_ACTIVE_HIGH>
        , <&pro_micro 7 GPIO_ACTIVE_HIGH>
        , <&pro_micro 8 GPIO_ACTIVE_HIGH>
        , <&pro_micro 9 GPIO_ACTIVE_HIGH>
        ;
};

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                <NRF_PSEL(SPIM_MISO, 0, 10)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                <NRF_PSEL(SPIM_MISO, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi1 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        zephyr,axis-x = <INPUT_REL_Y>;
        zephyr,axis-y = <INPUT_REL_X>;
        invert-x;

        /* 400 CPI: reduces raw delta-1 noise event frequency from sensor.
           Combined with 1/2 scaler = smooth ~200 CPI effective cursor feel.
           Increase back to 800 if cursor feels too slow for your preference. */
        res-cpi = <400>;
        smart-mode;
        /* force-awake removed: was causing continuous sensor polling noise
           which triggered phantom mouse layer activations. smart-mode handles sleep. */
    };
};

/ {
    input_processors {
        zip_xy_scaler: zip_xy_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_X INPUT_REL_Y>;
        };

        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
            /* 800ms idle after last keypress before trackball can activate mouse layer.
               Increased from 500ms for stronger typing vibration protection. */
            require-prior-idle-ms = <800>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        /* Base: scale only — no temp-layer at top level to prevent noise
           events from triggering layer activation before scaler discards them. */
        input-processors = <&zip_xy_scaler 1 2>;

        /* Only activate mouse layer when coming from a non-mouse layer */
        mouse_activate {
            layers = <0 1 2 3>;
            input-processors = <
                &zip_xy_scaler 1 2
                &zip_temp_layer 4 630
            >;
            process-next;
        };

        /* When already in mouse layer, just pass through scaled movement */
        mouse_passthrough {
            layers = <4>;
            input-processors = <&zip_xy_scaler 1 2>;
        };
    };
};
